{
  "mcpServers": {
    "alex-tavern-debug": {
      "command": "uv",
      "args": [
        "run",
        "python",
        "tools/mcp_server.py"
      ],
      "cwd": ".",
      "directTools": true
    },
    "alex-tavern-plugin-author": {
      "command": "uv",
      "args": [
        "run",
        "python",
        "mcp_server.py",
        "--core-root",
        "../alex-tavern"
      ],
      "cwd": "../alex-tavern-plugins",
      "directTools": true
    }
  }
}
